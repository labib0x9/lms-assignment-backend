{
  "kind": "collectionType",
  "collectionName": "quiz_submissions",
  "info": {
    "singularName": "quiz-submission",
    "pluralName": "quiz-submissions",
    "displayName": "Quiz Submission"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "quiz": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::quiz.quiz",
      "inversedBy": "submissions"
    },
    "score": {
      "type": "integer"
    },
    "total_score": {
      "type": "integer"
    },
    "submitted_at": {
      "type": "datetime"
    }
  }
}
